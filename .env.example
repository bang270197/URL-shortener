# Supabase transaction-pooler URI used by the Next.js runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres?pgbouncer=true&sslmode=require"

# Supabase direct PostgreSQL URI used by Prisma migration commands.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Public base URL used when returning newly created short links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
